{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "height": 15,
    "width": 30,
    "padding": {
      "top": 5
    }
  },

  "display": {
    "color": {
      "keys": ""
    },
    "separator": " \uf061 ",
    "constants": [
      "\u001b[s",
      "\u001b[u\u001b[14C",
      "\u001b[38;2;230;138;66m",
      "\u001b[38;2;214;93;14m",
      "\u001b[38;2;240;192;64m",
      "\u001b[38;2;215;153;33m",
      "\u001b[38;2;106;181;184m",
      "\u001b[38;2;69;133;136m",
      "\u001b[38;2;208;112;160m",
      "\u001b[38;2;177;98;134m",
      "\u001b[38;2;196;195;48m",
      "\u001b[38;2;152;151;26m",
      "\u001b[38;2;139;192;140m",
      "\u001b[38;2;104;157;106m"
    ],
    "brightColor": false
  },

  "modules": [
    { "type": "break" },
    { "type": "custom", "format": "{#bright_yellow}󰮯{#dim_white} ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ {#37} 󰊠 {#36} 󰊠 {#35} 󰊠 {#34} 󰊠 {#33} 󰊠 {#32} 󰊠 {#31} 󰊠" },

    { "type": "break" },
    { "type": "custom", "key": " ", "format": "\uf017 System" },
    { "type": "title", "keyIcon": "\uf2dc", "key": "{$4}├─   {$1}Login{$2}" },
    { "type": "os", "key": "{$4}├─ 󰣇  {$1}OS{$2}" },
    { "type": "kernel", "key": "{$4}├─   {$1}Kernel{$2}" },
    { "type": "packages", "key": "{$4}├─   {$1}Packages{$2}" },
    { "type": "uptime", "key": "{$4}└─   {$1}Uptime{$2}" },

    { "type": "break" },
    { "type": "custom", "key": " ", "format": "\uf085 Hardware" },
    { "type": "board", "key": "{$6}├─   {$1}Board{$2}" },
    { "type": "bios", "key": "{$6}│  └─   {$1}BIOS{$2}", "format": "{4} ({1})" },
    { "type": "host", "key": "{$6}├─   {$1}Chassis{$2}" },
    { "type": "cpu", "key": "{$6}├─   {$1}CPU{$2}", "format": "{1} - ({3}C/{5}T) - {8}", "temp": true },
    { "type": "gpu", "key": "{$6}├─   {$1}GPU{$2}", "temp": true },
    { "type": "display", "format": "{inch}\" {refresh-rate}Hz {width}x{height} {name}", "key": "{$6}└─   {$1}Display{$2}" },

    { "type": "break" },
    { "type": "custom", "key": " ", "format": "\uf233 Memory" },
    { "type": "memory", "key": "{$8}├─   {$1}RAM{$2}", "format": "{percentage-bar} {used} / {total}", "percent": { "type": 3, "green": 20, "yellow": 70 } },
    { "type": "swap", "key": "{$8}└─   {$1}SWAP{$2}", "format": "{percentage-bar} {used} / {total}", "percent": { "type": 3, "green": 20, "yellow": 70 } },

    { "type": "break" },
    { "type": "custom", "key": " ", "format": "\uf07c Storage" },
    { "type": "disk", "key": "{$10}└─ 󰋊  {$1}Disk{$2}", "format": "{size-percentage-bar} {size-used} / {size-total} [{filesystem}] ({mountpoint})", "percent": { "type": 3, "green": 20, "yellow": 70 } },

    { "type": "break" },
    { "type": "custom", "key": " ", "format": "\uf108 Desktop" },
    { "type": "de", "key": "{$13}├─   {$1}Desktop{$2}" },
    { "type": "command", "key": "{$13}├─   {$1}Session{$2}", "text": "printf '%s (%s)' \"$XDG_CURRENT_DESKTOP\" \"$XDG_SESSION_TYPE\"" },
    { "type": "theme", "key": "{$13}├─   {$1}GTK Theme{$2}", "format": "{2}" },
    { "type": "icons", "key": "{$13}├─   {$1}Icon Set{$2}" },
    { "type": "lm", "key": "{$13}├─ 󰍂  {$1}Login Manager{$2}" },
    { "type": "bootmgr", "key": "{$13}└─ 󰯔  {$1}Boot Manager{$2}" },

    { "type": "break" },
    { "type": "custom", "key": " ", "format": "\uf120 Terminal" },
    { "type": "shell", "key": "{$14}├─   {$1}Shell{$2}" },
    { "type": "terminal", "key": "{$14}└─   {$1}Terminal{$2}" },

    { "type": "break" },
    { "type": "custom", "format": "{#bright_yellow}󰮯{#dim_white} ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ ⚬ {#37} 󰊠 {#36} 󰊠 {#35} 󰊠 {#34} 󰊠 {#33} 󰊠 {#32} 󰊠 {#31} 󰊠" }
  ]
}